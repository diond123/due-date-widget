{
  "name": "due-date-widget",
  "productName": "Due Date Widget",
  "version": "1.0.0",
  "description": "Desktop widget that shows upcoming assessment due dates parsed from your subject outlines.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.duedatewidget.app",
    "productName": "Due Date Widget",
    "files": [
      "src/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png"
    },
    "dmg": {
      "title": "Due Date Widget"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
